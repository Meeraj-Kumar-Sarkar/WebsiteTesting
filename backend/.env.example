# Copy this file to .env and fill in your required keys
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Authentication & Security Keys
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h

# Database Connection (PostgreSQL)
# Leave blank to use local file persistence (backend/data/store.json)
DATABASE_URL=

# Initial Master Administrator Credentials (used on first bootstrap)
MASTER_ADMIN_EMP_ID=EMP-1001
MASTER_ADMIN_NAME=Master Administrator
MASTER_ADMIN_EMAIL=admin@mountainandmemories.com
MASTER_ADMIN_PHONE=+91 98765 43210
MASTER_ADMIN_PASSWORD=Password@123

# Email / OTP Dispatch API Key (Resend API)
RESEND_API_KEY=
EMAIL_FROM=no-reply@mountainandmemories.com

# Storage & Media Configuration ('local' or 'r2')
STORAGE_PROVIDER=local
MEDIA_PUBLIC_URL=http://localhost:5000/uploads
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Payment / UPI Configuration
UPI_ID=mountainmemories@bank
UPI_NAME=Mountain and Memories Travel LLP
