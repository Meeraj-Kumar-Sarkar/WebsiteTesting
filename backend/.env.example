# Copy this file to .env and fill in your values
PORT=5000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h

# Comma-separated allowed origins for CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# UPI payment details (shown on invoices)
UPI_ID=yourvpa@bank
UPI_NAME=Your Company Name

# Optional: PostgreSQL connection string
# If omitted, the app uses local JSON file storage (backend/data/store.json)
# DATABASE_URL=postgresql://user:password@localhost:5432/mountain_memories
